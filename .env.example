# Copy this file to `.env` (which git ignores) and fill in the secrets:
#     cp .env.example .env
# Every variable below is required: the backend refuses to start without them.
# Generate a secret with:  openssl rand -hex 32

# ─── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=matcha
POSTGRES_PASSWORD=change-me
POSTGRES_DB=matcha

# ─── Redis (sessions, rate limiting, live notifications and chat) ───
REDIS_PASSWORD=change-me

# ─── Secrets that sign the session cookie and the emailed links ───
SESSION_SECRET=change-me-with-openssl-rand-hex-32
MAIL_SECRET=change-me-with-openssl-rand-hex-32

# ─── Environment ───────────────────────────────────────
# Anything other than "production" lets the session cookie work over plain http (localhost).
ENV=development
FRONTEND_URL="http://localhost:5173"

# ─── Google sign-in ────────────────────────────────────
# The app starts with these placeholders; "Sign in with Google" only works with real
# credentials (Google Cloud Console > APIs & Services > Credentials > OAuth client ID,
# authorized redirect URI = GOOGLE_REDIRECT_URI below). Email + password login does not need them.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI="http://localhost:5000/oauth/google/callback"
